<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Runway.Core.Tests</RootNamespace>
    <AssemblyName>Runway.Core.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Only the files listed below compile: the SAME sources Unity builds. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="EconomyProbe.cs" />
    <Compile Include="Lanes/*.cs" />
    <Compile Include="../Assets/Scripts/Core/*.cs" />
    <Compile Include="../Assets/Scripts/Core/Lanes/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the frozen pre-wave save travels with the binary so the save-compat
         check runs wherever the suite runs -->
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
