# SECRETS — never, under any circumstance
game/.env
*.env
*key.txt

# GENERATED ART. assets/scenes alone is 5.4GB, and all of it is reproducible from
# tools/scene_pipeline.py. Excluded so that a lane's PR shows the code and data it
# changed instead of drowning in binaries.
# ignore ALL generated art, then allow back only what the UI cannot run without
game/assets/*
!game/assets/fonts/
!game/assets/ui/
# layout.json is NOT generated art. Crew marks, occluder rects and write_surfaces
# are hand-authored from measurements taken off each image and cannot be recovered
# by rerunning anything — 28K of irreplaceable data sitting inside 5.4GB of
# reproducible pixels. gitignore cannot re-include a file whose parent directory is
# excluded, so the tree has to be re-opened level by level.
!game/assets/scenes/
game/assets/scenes/*
!game/assets/scenes/*/
game/assets/scenes/*/*
!game/assets/scenes/*/layout.json
!game/assets/scenes/scenes_index.json
music/
*.wav
*.mp3
*.mp4

# Godot regenerates these with `godot --headless --path . --import`
*.import
game/.godot/
game/.import/

# local safety-net snapshots (snapshot.sh) and anything restored from one
.snapshots/
restored-*/

# lane scratch
/tmp/
*.log

.DS_Store

# python bytecode
__pycache__/
*.pyc
