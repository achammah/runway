# SECRETS — never, under any circumstance
game/.env
*.env
*key.txt

# GENERATED ART. assets/scenes alone is 5.4GB, and all of it is reproducible from
# tools/scene_pipeline.py. Excluded so that a lane's PR shows the code and data it
# changed instead of drowning in binaries.
# ignore ALL generated art, then allow back only what the UI cannot run without
game/assets/*
!game/assets/fonts/
!game/assets/ui/
!game/assets/backgrounds/
game/assets/backgrounds/*
!game/assets/backgrounds/*.json
# layout.json is NOT generated art. Crew marks, occluder rects and write_surfaces
# are hand-authored from measurements taken off each image and cannot be recovered
# by rerunning anything — 28K of irreplaceable data sitting inside 5.4GB of
# reproducible pixels. gitignore cannot re-include a file whose parent directory is
# excluded, so the tree has to be re-opened level by level.
!game/assets/scenes/
game/assets/scenes/*
!game/assets/scenes/*/
game/assets/scenes/*/*
!game/assets/scenes/*/layout.json
!game/assets/scenes/scenes_index.json
music/
*.wav
*.mp3
*.mp4

# Godot regenerates these with `godot --headless --path . --import`
*.import
game/.godot/
game/.import/

# local safety-net snapshots (snapshot.sh) and anything restored from one
.snapshots/
restored-*/

# lane scratch
/tmp/
*.log

.DS_Store

# python bytecode
__pycache__/
*.pyc

# build output
dist/

# Unity + dotnet regenerate these; the Core test runner writes bin/obj on every run
unity/**/bin/
unity/**/obj/
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/Builds/

# Unity mirrors of the local-only art (staged by Build.EnsureSheets at build time)
unity/Assets/Resources/Sheets/
unity/Assets/Art/
unity/Assets/StreamingAssets/Art/
unity/build/

# Hand authored data inside the ignored art trees. Same argument as layout.json
# above: these are measured and curated by hand and cannot be regenerated. Without
# these rules a NEW pose, icon or patch scene is silently invisible to git add.
!game/assets/journal_icons/
!game/assets/poses/
game/assets/poses/*
!game/assets/poses/*.json
!game/assets/poses/*/
game/assets/poses/*/*
!game/assets/poses/*/*.json
!game/assets/patch_scenes/
game/assets/patch_scenes/*
!game/assets/patch_scenes/*.json
!game/assets/patch_scenes/*/
game/assets/patch_scenes/*/*
!game/assets/patch_scenes/*/*.json
!game/assets/scenes/*.json
game/build_stamp.txt
