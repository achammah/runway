# RUNWAY! runtime LLM layer ("Simulation Engine", PRD §7)
# Copy to .env (gitignored). The game runs fully without any key — authored events only.
# Provider is auto-detected: OPENAI_API_KEY -> OpenAI, ANTHROPIC_API_KEY -> Anthropic.
# If both are set, LLM_PROVIDER wins.

#LLM_PROVIDER=openai            # openai | anthropic (optional; auto-detected from keys)
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-5-mini
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-haiku-4-5-20251001
